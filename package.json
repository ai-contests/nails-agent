{
  "name": "nails-agent",
  "version": "1.0.0",
  "description": "Nails-Agent - AI Nail Try-on & Intelligent Operations",
  "main": "src/api/server.ts",
  "private": true,
  "type": "module",
  "workspaces": [
    "db",
    "tools/extraction"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "bun --bun next build",
    "start": "next start",
    "bun:dev": "bun run src/api/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "extract": "npm run extract --prefix tools/extraction && npm run grid",
    "db:setup": "npm run db:setup --prefix db",
    "grid": "python3 scripts/make_grid.py",
    "setup": "npm run extract && npm run db:setup",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "next-intl": "^4.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.8",
    "@types/node": "^22.5.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.10.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0"
  }
}
