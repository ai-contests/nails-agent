{
  "name": "@nails-agent/db",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite schema + seed for nails-agent (Drizzle ORM)",
  "type": "module",
  "scripts": {
    "db:reset": "tsx src/reset.ts",
    "db:migrate": "drizzle-kit push",
    "db:seed": "tsx src/seed/index.ts",
    "db:check": "tsx src/check.ts",
    "db:setup": "npm run db:reset && npm run db:migrate && npm run db:seed && npm run db:check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
