# Copy to .env and fill in. Never commit .env.

# ModelScope — Agent / B 端 Chat LLM
MODELSCOPE_API_KEY=
MODELSCOPE_API_URL=https://api-inference.modelscope.cn/v1/chat/completions
MODELSCOPE_MODEL=Qwen/Qwen3-14B
MODELSCOPE_ENABLE_THINKING=false
MODELSCOPE_MAX_TOKENS=2048
MODELSCOPE_RESPONSE_FORMAT=json_object

# ComfyCloud — 试戴管线
COMFYCLOUD_API_KEY=comfyui-...
COMFYCLOUD_BASE=https://cloud.comfy.org/api

# Roboflow — 美甲分割（tools/extraction）
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=fingernail-segmentation-yy1l7/3
ROBOFLOW_CONFIDENCE=0.5

# Agent 运营节奏
# AGENT_REVIEW_WINDOW_HOURS: proposal 执行后多久才触发复盘
#   开发/测试阶段建议 0.1（6 分钟），方便快速验证复盘逻辑
#   演示阶段建议 0.5～1（30min～1h），每轮操作完马上能看到学习结果
#   生产阶段建议 12（与 cycle 间隔对齐）
AGENT_REVIEW_WINDOW_HOURS=0.1

# Hand analyzer — 用户手型/肤色识别（TS 后端调用 Python MediaPipe）
HAND_ANALYZER_PYTHON=/Users/zhouxing/code/meituan/demo_v1/.venv/bin/python
HAND_ANALYZER_ROOT=/Users/zhouxing/code/meituan/demo_v1
HAND_ANALYZER_TIMEOUT_MS=15000
