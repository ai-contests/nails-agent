{
  "name": "nails-agent",
  "version": "1.0.0",
  "description": "Nails-Agent - AI Nail Try-on & Intelligent Operations",
  "main": "src/api/server.ts",
  "type": "module",
  "workspaces": [
    "db",
    "tools/extraction"
  ],
  "scripts": {
    "dev": "bun run src/api/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "extract": "npm run extract --prefix tools/extraction && npm run grid",
    "db:setup": "npm run db:setup --prefix db",
    "grid": "python3 scripts/make_grid.py",
    "setup": "npm run extract && npm run db:setup",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.4",
    "@types/bun": "^1.1.8",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.10.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.5.0"
  }
}

