# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.pytest_cache/

# macOS / IDE
.DS_Store
.vscode/
.idea/

# transient outputs
*.tmp
*.log

# ─── data/ ───────────────────────────────────────────────────────
# Large binary assets (images, models, generated outputs, SQLite db)
# are NOT committed. Collaborators restore them from the external dataset
# link or regenerate via scripts.
#
# Exception: the three lightweight seed-critical text files are tracked
# so collaborators can run `npm run db:setup` out of the box.
data/*
!data/.gitkeep
!data/pairs.csv
!data/nail_refs.csv
!data/extraction/
data/extraction/*
!data/extraction/manifest.json
!data/hand_landmarker.task
!data/seed_hands/
db/data/

# ─── scripts/ ────────────────────────────────────────────────────
# 本地 Python 工具集（试戴管线 / 手模生成 / 批量 runner）。
# 用于一次性构造 data/ 资产与 mock 数据，不进 v1 Demo 运行路径，
# 不入仓库。Next.js 运行栈走 TypeScript + LangGraph.js。
scripts/*
!scripts/analyze_hand.py

# 本地图像提取脚手架（OpenCV / Roboflow 调用），不入仓库
extract_nails.py
nail_extractor.py

# Node.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
